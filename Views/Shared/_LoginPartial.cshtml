@using Microsoft.AspNetCore.Identity
@inject SignInManager<WebApplication4.Models.ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var userManager = Context.RequestServices.GetRequiredService<UserManager<WebApplication4.Models.ApplicationUser>>();
        var user = await userManager.GetUserAsync(User);
        var avatarUrl = user?.ProfilePictureUrl ?? "/uploads/avatars/default.png";
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                <img src="@avatarUrl" width="30" height="30" class="rounded-circle" />
                Привет, @User.Identity?.Name!
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Выйти</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Войти</a>
        </li>
    }
</ul>