@model List<WebApplication4.Models.Greeting>
@using Microsoft.AspNetCore.Identity
@inject UserManager<WebApplication4.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Доска сообщений";
    var currentUserId = UserManager.GetUserId(User);
    bool isAdmin = ViewData["IsAdmin"] as bool? ?? false;

    int currentPage = ViewData["CurrentPage"] as int? ?? 1;
    int totalPages = ViewData["TotalPages"] as int? ?? 0;
    string search = ViewData["Search"] as string ?? "";
}

<h1 class="display-4">Все сообщения</h1>


<!-- Форма поиска -->
<form method="get" asp-action="Index" class="row g-3 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Поиск..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Найти</button>
    </div>
    @if (!string.IsNullOrEmpty(search))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    }
</form>

<form asp-action="Hello" method="post" class="row g-2 mb-3">
    @Html.AntiForgeryToken()
    <div class="col-auto">
        <input type="text" name="Name" class="form-control" placeholder="Введите сообщение..." required maxlength="50" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">Отправить</button>
    </div>
</form>


@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        @if (!string.IsNullOrEmpty(search))
        {
            <span>По запросу «@search» ничего не найдено.</span>
        }
        else
        {
            <span>Пока никто не поздоровался. Будь первым!</span>
        }
    </div>
}

else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Сообщение</th>
                <th>Автор</th>
                <th>Дата и время</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var greeting in Model)
            {
                <tr>
                    <td>@greeting.Name</td>
                    <td>
                        <img src="@(greeting.User?.ProfilePictureUrl ?? "/uploads/avatars/default.png")" 
                             width="24" height="24" class="rounded-circle me-1" />
                        @greeting.User?.UserName
                    </td>
                    <td>@greeting.CreatedAt.ToString("g")</td>
                    <td>
                        @if (greeting.UserId == currentUserId || isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@greeting.Id" class="btn btn-sm btn-warning">Редактировать</a>
                            <a asp-action="Delete" asp-route-id="@greeting.Id" class="btn btn-sm btn-danger">Удалить</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search">Предыдущая</a>
                    </li>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search">@i</a>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search">Следующая</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

