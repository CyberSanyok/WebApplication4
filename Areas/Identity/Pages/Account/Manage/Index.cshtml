@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <!--аватарка-->
        <div class="text-center mb-3">
            <img id="avatar-img" 
                 src="@(Model.ProfilePictureUrl ?? "/uploads/avatars/default.png")" 
                 alt="Avatar" class="rounded-circle" width="100" height="100" />
            <br />
            <input type="file" id="avatar-input" accept="image/*" style="display: none;" />
            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" 
                    onclick="document.getElementById('avatar-input').click()">
                Выбрать фото
            </button>
            <span id="upload-status" class="text-success ms-2"></span>
        </div>

       
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" />
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('avatar-input').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (!file) return;

            var formData = new FormData();
            formData.append('avatar', file);

            document.getElementById('upload-status').textContent = 'Загрузка...';

            var token = document.querySelector('#profile-form input[name="__RequestVerificationToken"]')?.value;

            fetch('?handler=UploadAvatar', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('avatar-img').src = data.url + '?t=' + new Date().getTime();
                    document.getElementById('upload-status').textContent = 'Готово!';
                } else {
                    document.getElementById('upload-status').textContent = 'Ошибка: ' + (data.error || 'неизвестно');
                }
            })
            .catch(err => {
                document.getElementById('upload-status').textContent = 'Ошибка соединения';
                console.error(err);
            });
        });
    </script>
}